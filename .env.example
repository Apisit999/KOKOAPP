# Copy to .env for a local development License Server. Never commit .env or secrets/.
LICENSE_ENV=development
LICENSE_HOST=127.0.0.1
LICENSE_PORT=8787
LICENSE_DB_PATH=./data/koko-license.sqlite
KOKO_PHOTO_CLOUD_PATH=./data/photo-cloud
# Defaults copied to newly seeded plans. Adjust individual plans with the admin API.
KOKO_PHOTO_CLOUD_RETENTION_DAYS=90
KOKO_PHOTO_CLOUD_TENANT_QUOTA_BYTES=5368709120
LICENSE_PRIVATE_KEY_FILE=./secrets/license-private.pem
LICENSE_KEY_ID=koko-local-dev-1
LICENSE_ADMIN_TOKEN=replace-with-a-random-secret-at-least-32-characters
LICENSE_PRODUCT_ID=koko-photobooth
LICENSE_OFFLINE_GRACE_HOURS=72
LICENSE_REFRESH_HOURS=24

# Desktop public configuration only. This contains a PUBLIC key, never the server private key.
KOKO_LICENSE_API_BASE_URL=http://127.0.0.1:8787
KOKO_PHOTO_PUBLIC_BASE_URL=http://127.0.0.1:8787
KOKO_LICENSE_PRODUCT_ID=koko-photobooth
KOKO_LICENSE_TRUSTED_KEYS_JSON={}
