  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler",
    "jsx": "react-jsx", "strict": true, "noEmit": true, "skipLibCheck": true,
    "esModuleInterop": true, "allowImportingTsExtensions": true, "lib": ["ES2022", "DOM"], "types": ["node"]
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "forge.env.d.ts"]
}
