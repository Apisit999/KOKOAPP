.strip-empty { display: flex; align-items: center; min-height: 61px; padding: 0 10px; border: 1px dashed rgba(216,181,106,.16); border-radius: 7px; color: #817c70; font-size: 11px }
.capture-actions { display: grid; justify-items: center; gap: 5px }
.capture-disc { display: grid; place-items: center; width: 72px; height: 72px; padding: 0; border: 1px solid #f1d99d; border-radius: 50%; background: linear-gradient(145deg,#f4d99a 1%,#dbb96f 52%,#b08a44 100%); color: #261e10; box-shadow: inset 0 0 0 4px rgba(255,248,221,.2),0 4px 16px rgba(166,128,58,.12); transition: transform .16s,filter .16s }
.capture-disc>span { display: grid; place-items: center; width: 55px; height: 55px; border: 1px solid rgba(63,49,23,.3); border-radius: 50% }
.capture-disc:hover:not(:disabled) { transform: translateY(-2px); filter: brightness(1.08) }
.capture-disc:active:not(:disabled) { transform: scale(.96) }
.capture-disc:disabled { filter: saturate(.34); opacity: .5 }
.capture-caption { color: #c7b987; font-size: 9px; letter-spacing: .17em }
.export-latest { min-height: 28px; padding: 0 6px; border: 0; background: transparent; color: #a69b7d; font-size: 9px }
