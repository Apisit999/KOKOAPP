/* Capture Studio: reference-led black and gold workspace. */
:root { --serif: Georgia, 'Noto Serif Thai', 'Leelawadee UI', serif; --studio-border: rgba(216,181,106,.22) }
html, body, #root { min-width: 360px; background: var(--bg) }
button { -webkit-tap-highlight-color: transparent }
.shell { grid-template-columns: 220px minmax(0,1fr); min-height: 100vh; background: var(--bg) }
.sidebar { position: sticky; height: 100vh; padding: 25px 14px 17px; background: linear-gradient(180deg,#0b0b0b 0%,#090909 100%); border-right: 1px solid rgba(216,181,106,.12) }
.brand-button { display: grid; gap: 3px; width: 100%; padding: 5px 12px 10px; border: 0; background: none; text-align: left }
.brand-wordmark { color: var(--gold-light); font: 500 35px/.95 var(--serif); letter-spacing: .08em }
.brand-subtitle { color: #d8c18f; font-size: 10px; letter-spacing: .31em }
.side-label { margin: 35px 12px 11px; color: #706b60; font-size: 9px; letter-spacing: .23em }
.sidebar nav { gap: 5px }
.sidebar nav button,.sidebar-account { min-height: 45px; gap: 13px; padding: 0 12px; border-radius: 9px; color: #aaa69d; font-size: 12px; transition: color .16s,background .16s,border-color .16s }
.sidebar nav button:hover,.sidebar-account:hover { background: #151515; color: var(--text) }
.sidebar nav button.active,.sidebar-account.active { border-color: rgba(216,181,106,.32); background: linear-gradient(100deg,rgba(216,181,106,.11),rgba(255,255,255,.025) 75%); color: var(--gold-light) }
.sidebar nav button.active::before,.sidebar-account.active::before { top: 8px; bottom: 8px; background: var(--gold) }
.nav-icon { flex: 0 0 20px; width: 20px; color: #8a877f }
.sidebar nav .active .nav-icon,.sidebar-account.active .nav-icon { color: var(--gold-light) }
.sidebar-bottom { gap: 8px }
.sidebar-license { display: flex; align-items: center; gap: 9px; min-height: 35px; padding: 6px 9px; border-top: 1px solid rgba(216,181,106,.13); color: #b8b1a0; font-size: 10px }
.license-dot,.camera-status-pill i,.studio-live-state i,.storage-ready i { display: inline-block; flex: 0 0 auto; width: 7px; height: 7px; border-radius: 50%; background: #716c60 }
.license-dot.good,.storage-ready.is-ready i { background: #8ea68e; box-shadow: 0 0 0 3px rgba(142,166,142,.12) }
.sidebar-account { position: relative; display: flex; align-items: center; width: 100%; min-height: 38px; padding: 0 9px; border: 1px solid transparent; border-radius: 8px; background: transparent; color: #a9a59b; text-align: left; font-size: 10px }
.sidebar-account>svg:last-child { margin-left: auto }
.edition-meta { padding: 12px 9px 0; border-top: 1px solid rgba(216,181,106,.1); color: #827b6b; font-size: 8px; letter-spacing: .14em }
.edition-meta small { color: #b5ad9b; font-size: 9px }
.workspace { min-width: 0; background: radial-gradient(ellipse at 56% -25%,rgba(188,151,77,.06),transparent 48%),var(--bg) }
.topbar { height: 61px; padding: 0 clamp(22px,2.5vw,38px); border-bottom-color: rgba(216,181,106,.13); background: rgba(8,8,8,.97); color: #c4c0b6; font-size: 12px }
.topbar-title { display: flex; align-items: center; min-width: 0; gap: 0 }
.topbar-title>span:last-child { overflow: hidden; color: #e6e0d2; text-overflow: ellipsis; white-space: nowrap }
.crumb { color: #908368 }
.topbar-actions { gap: 14px }
.camera-top-status { gap: 8px; color: #928d81; font-size: 10px }
.camera-top-status i { width: 7px; height: 7px; border: 1px solid #68645b; background: #373630 }
.camera-top-status.good { color: #b3c0aa }
.camera-top-status.good i { border: 0; background: #8ea68e; box-shadow: 0 0 0 3px rgba(142,166,142,.12) }
.topbar-settings { display: grid; place-items: center; width: 34px; height: 34px; border: 1px solid rgba(216,181,106,.14); border-radius: 8px; background: transparent; color: #c8c0ae }
.topbar-settings:hover { border-color: var(--studio-border); color: var(--gold-light) }
.topbar-account { display: inline-flex; align-items: center; gap: 8px; color: #c8c0ae; font-size: 11px }
.topbar-account:hover { color: var(--gold-light) }
.license-chip { min-height: 31px; padding: 6px 11px; border-color: rgba(216,181,106,.22); border-radius: 7px; color: #b2a581; font-size: 9px; letter-spacing: .09em }
.license-chip>span { background: #8b8069 }
.license-chip.is-active { color: var(--gold-light) }
.license-chip.is-active>span { background: #9cac91 }
.version { display: none }
.page-content { width: min(1680px,100%); padding: 25px clamp(20px,2.5vw,38px) 34px }
.page-content h1 { font-family: var(--serif); font-size: clamp(29px,3.15vw,45px); font-weight: 400; letter-spacing: -.035em; line-height: 1.1 }
.eyebrow { color: #c6a861; font-size: 9px; letter-spacing: .23em }
.lead { color: var(--secondary); font-size: 13px; line-height: 1.7 }
.studio-page { width: 100%; padding-top: 26px }
.studio-heading { display: flex; align-items: end; justify-content: space-between; gap: 18px; margin: 0 0 20px }
.studio-heading h1 { margin: 5px 0 6px; color: var(--text); font-size: clamp(34px,3.5vw,48px); line-height: 1.04 }
.studio-tagline { margin: 0; color: #948a73; font-size: 10px; letter-spacing: .27em }
.studio-live-state { display: inline-flex; align-items: center; gap: 8px; flex: 0 0 auto; margin: 0 0 8px; padding: 7px 10px; border: 1px solid rgba(255,255,255,.1); border-radius: 6px; color: #97938a; font-size: 9px; letter-spacing: .12em }
.studio-live-state.is-live { border-color: rgba(142,166,142,.25); color: #b2c0ad }
.studio-live-state.is-live i { background: #8ea68e; box-shadow: 0 0 0 3px rgba(142,166,142,.12) }
.camera-panel.studio-layout { display: grid; grid-template-columns: minmax(0,1.56fr) minmax(310px,.98fr); align-items: start; gap: clamp(12px,1.35vw,20px); min-width: 0; padding: 0; border: 0; border-radius: 0; background: transparent }
.studio-left { display: grid; gap: 11px; min-width: 0 }
.camera-selector-row { display: flex; align-items: center; gap: 10px; min-width: 0; min-height: 40px }
.camera-status-pill { display: inline-flex; align-items: center; gap: 8px; flex: 0 0 auto; color: #a19b8e; font-size: 10px }
.camera-status-pill.is-ready { color: #b1c0aa }
.camera-status-pill.is-ready i { background: #8ea68e; box-shadow: 0 0 0 3px rgba(142,166,142,.12) }
.camera-status-pill.is-error { color: #d09287 }
.camera-status-pill.is-error i { background: #c87c72 }
.camera-select-label { display: flex; align-items: center; gap: 8px; min-width: 0; margin-left: auto; color: #9c978c; font-size: 10px }
.camera-select-label>span { flex: 0 0 auto }
.camera-select-label select { width: min(260px,26vw); min-height: 36px; padding: 7px 31px 7px 11px; border: 1px solid rgba(216,181,106,.2); border-radius: 7px; background: #111; color: #e1ddd4; font-size: 11px }
.icon-button { display: grid; flex: 0 0 auto; place-items: center; width: 35px; height: 35px; border: 1px solid rgba(216,181,106,.19); border-radius: 8px; background: #111; color: #c5b991; transition: background .15s,border-color .15s,color .15s }
.icon-button:hover { border-color: rgba(216,181,106,.48); background: #191711; color: var(--gold-light) }
.camera-preview { position: relative; display: grid; place-items: center; width: 100%; min-width: 0; min-height: 260px; aspect-ratio: 16/9; overflow: hidden; border: 1px solid rgba(216,181,106,.35); border-radius: 11px; background: #050505; box-shadow: inset 0 0 0 5px rgba(216,181,106,.035),0 14px 36px rgba(0,0,0,.24) }
.camera-preview video { display: block; width: 100%; height: 100%; background: #050505 }
.camera-preview video.mirror-preview { transform: scaleX(-1) }
.camera-placeholder { position: relative; z-index: 1; display: flex; align-items: center; justify-content: center; gap: 10px; width: min(390px,80%); padding: 22px; color: #e5dfd2; text-align: center }
.camera-placeholder .placeholder-icon { display: grid; place-items: center; width: 58px; height: 58px; margin-bottom: 3px; border: 1px solid rgba(216,181,106,.26); border-radius: 50%; color: var(--gold-light) }
.camera-placeholder strong { font-family: var(--serif); font-size: 22px; font-weight: 400 }
.camera-placeholder small { max-width: 300px; color: #98948b; font-size: 11px; line-height: 1.65 }
.preview-start { display: inline-flex; align-items: center; justify-content: center; gap: 8px; min-height: 37px; margin-top: 7px; padding: 0 13px; border: 1px solid rgba(216,181,106,.36); border-radius: 7px; background: linear-gradient(145deg,#e6c77e,#c39c50); color: #211b0f; font-size: 11px; font-weight: 650 }
.preview-start:hover { background: var(--gold-light) }
.preview-corners { position: absolute; z-index: 2; inset: 13px; pointer-events: none }
