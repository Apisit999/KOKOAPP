.account-state,.plan-state { display: flex; align-items: flex-start; gap: 14px; max-width: 850px; padding: 18px }.account-state-icon { display: grid; flex: 0 0 auto; place-items: center; width: 35px; height: 35px; border: 1px solid var(--border); border-radius: 8px; color: var(--gold); font-size: 15px }.account-state h2,.plan-state h2 { margin: 8px 0; font-size: 13px }.account-state p,.plan-state p { max-width: 650px; margin: 6px 0; color: var(--secondary); font-size: 10px; line-height: 1.7 }.account-state .muted { color: #aaa38f }.activate-card { max-width: 850px; margin-top: 13px; padding: 19px; border: 1px solid rgba(255,255,255,.08); border-radius: 9px; background: var(--panel) }.activate-card h2 { margin: 0; font-size: 13px }.activate-card>p { color: var(--secondary); font-size: 10px; line-height: 1.7 }.activate-card form { display: flex; align-items: end; gap: 10px }.activate-card label { display: grid; flex: 1; gap: 6px; color: #c7c4ba; font-size: 10px }.activate-card input { width: 100%; min-height: 41px; padding: 9px 11px; border: 1px solid rgba(255,255,255,.13); border-radius: 6px; background: var(--raised); color: var(--text) }.activation-error { color: var(--red); font-size: 10px }.plan-state { align-items: center; justify-content: space-between; margin-top: 13px }.plan-state>div { max-width: 640px }.account-links { display: flex; gap: 9px; margin-top: 13px }.account-links button { padding: 10px 12px; border: 1px solid rgba(255,255,255,.1); border-radius: 6px; background: var(--panel); color: #d0bd8d; font-size: 10px }
.empty-state { display: grid; justify-items: center; max-width: 720px; margin: 7vh auto; padding: 38px 27px; border: 1px dashed rgba(214,179,106,.2); border-radius: 10px; background: var(--panel); text-align: center }.empty-state>span { color: var(--gold-muted); font-size: 34px }.empty-state h2 { margin: 12px 0 5px; font-size: 15px }.empty-state p { max-width: 520px; color: var(--secondary); font-size: 10px; line-height: 1.8 }.empty-state .camera-secondary { margin-top: 8px }.error-state>span { color: var(--red) }.notice { position: fixed; z-index: 8; right: 22px; bottom: 20px; max-width: min(500px,calc(100vw - 40px)); padding: 11px 14px; border: 1px solid var(--border); border-radius: 7px; background: #191814; color: var(--gold-light); box-shadow: 0 8px 30px #0008; font-size: 10px }
.gallery-title-row { display: flex; align-items: end; justify-content: space-between; gap: 16px }.gallery-title-row h1 { margin: 8px 0 4px }.gallery-title-row .lead { margin: 0 0 20px }.gallery-count { margin-bottom: 25px; color: var(--gold); font-size: 10px }.recovery-banner { display: flex; align-items: center; gap: 11px; margin-bottom: 14px; padding: 11px 13px; border: 1px solid rgba(214,179,106,.28); border-radius: 7px; background: #1a1813 }.recovery-banner>span { display: grid; flex: 0 0 auto; place-items: center; width: 23px; height: 23px; border-radius: 50%; background: #342d1e; color: var(--gold) }.recovery-banner strong,.recovery-banner small { display: block }.recovery-banner strong { font-size: 10px }.recovery-banner small { margin-top: 3px; color: #a49d89; font-size: 9px; line-height: 1.5 }.recovery-banner button { flex: 0 0 auto; margin-left: auto; border: 0; background: none; color: var(--gold); font-size: 9px }
.photo-grid { display: grid; grid-template-columns: repeat(4,minmax(0,1fr)); gap: 11px }.photo-card { overflow: hidden; border: 1px solid rgba(255,255,255,.08); border-radius: 8px; background: var(--panel) }.photo-thumb { position: relative; display: grid; place-items: center; width: 100%; aspect-ratio: 4/3; border: 0; background: #191a18; color: var(--gold-muted) }.photo-thumb>span { font-size: 35px }.photo-thumb small { position: absolute; right: 7px; bottom: 7px; padding: 3px 5px; border-radius: 3px; background: #090a0ccc; color: #cbc7bd; font-size: 8px }.photo-info { display: grid; gap: 5px; padding: 10px }.photo-info strong { overflow: hidden; color: #d7d4cb; font-size: 9px; text-overflow: ellipsis; white-space: nowrap }.photo-info>small { color: var(--secondary); font-size: 8px }.export-button { justify-self: start; margin-top: 3px; padding: 0; border: 0; background: none; color: var(--gold); font-size: 9px; font-weight: 600 }.export-button:disabled { color: #6b6963 }.load-more { display: flex; justify-content: center; margin: 20px }.photo-modal-backdrop { position: fixed; z-index: 9; inset: 0; display: grid; place-items: center; padding: 24px; background: #050505e8 }.photo-modal { position: relative; display: flex; flex-direction: column; width: min(900px,100%); max-height: 90vh; overflow: hidden; border: 1px solid var(--border); border-radius: 10px; background: var(--panel) }.photo-modal>img { display: block; width: 100%; height: min(70vh,720px); object-fit: contain; background: #08090a }.modal-close { position: absolute; z-index: 1; top: 10px; right: 10px; display: grid; place-items: center; width: 32px; height: 32px; border: 1px solid #6b624e; border-radius: 50%; background: #10100fdd; color: var(--text); font-size: 20px }.modal-caption { display: flex; align-items: center; justify-content: space-between; gap: 14px; padding: 11px 14px; color: #b5b1a6; font-size: 9px }.modal-caption .primary { min-height: 34px; font-size: 9px }.modal-loading,.modal-error { display: grid; place-items: center; min-height: 300px; color: #bdb9ae; font-size: 11px }.modal-error { color: var(--red) }.loading-mark { animation: spin 1.5s linear infinite }@keyframes spin { to { transform: rotate(360deg) } }
.photo-thumb img { width: 100%; height: 100%; object-fit: cover }.photo-placeholder-mark { color: var(--gold-muted) }.recent-frames img { display: block; width: 100%; height: 100%; object-fit: cover }.recent-frames .photo-placeholder-mark { display: grid; place-items: center; font-size: 18px }
.modal-actions { display: flex; align-items: center; gap: 8px }.delete-button { color: #d59088; border-color: rgba(202,129,120,.25) }.delete-button:hover { color: #f0aaa2; border-color: rgba(202,129,120,.55) }
