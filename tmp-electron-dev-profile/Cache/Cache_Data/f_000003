.studio-right { display: grid; gap: 11px; min-width: 0 }
.control-section { min-width: 0; padding: 15px; border: 1px solid rgba(216,181,106,.19); border-radius: 10px; background: linear-gradient(155deg,#131313,#101010 82%); box-shadow: 0 8px 25px rgba(0,0,0,.12) }
.section-heading { display: flex; align-items: center; justify-content: space-between; gap: 12px; margin-bottom: 15px }
.control-mark { display: grid; place-items: center; width: 26px; height: 26px; border: 1px solid rgba(216,181,106,.17); border-radius: 6px; color: #ac9560 }
.setting-row { display: grid; gap: 8px; margin-top: 14px }
.setting-row>span { color: #d0cbc0; font-size: 11px }
.segmented-control { display: grid; grid-template-columns: repeat(3,minmax(0,1fr)); padding: 3px; border: 1px solid rgba(255,255,255,.11); border-radius: 7px; background: #0a0a0a }
