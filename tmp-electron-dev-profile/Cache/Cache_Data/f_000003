.composition-grid i:nth-child(1),.composition-grid i:nth-child(2) { right: 0; left: 0; border-top: 1px solid rgba(255,255,255,.5) }
.composition-grid i:nth-child(1) { top: 33.33% }.composition-grid i:nth-child(2) { top: 66.66% }
.composition-grid i:nth-child(3),.composition-grid i:nth-child(4) { top: 0; bottom: 0; border-left: 1px solid rgba(255,255,255,.5) }
.composition-grid i:nth-child(3) { left: 33.33% }.composition-grid i:nth-child(4) { left: 66.66% }
.live-badge { z-index: 4; top: 14px; right: 14px; left: auto; gap: 7px; padding: 7px 10px; border-color: rgba(216,181,106,.3); border-radius: 5px; background: rgba(9,9,9,.83); color: var(--gold-light); font-size: 9px; letter-spacing: .12em }
