.coming-action>svg { grid-row: span 2; color: #7f7356 }
.coming-action small { color: #786f5b; font-size: 7px; letter-spacing: .12em }
.output-note { padding: 12px 14px; border-top: 1px solid rgba(216,181,106,.16); color: #a7a08f }
.output-note p { margin: 7px 0 5px; color: #918b7f; font-size: 10px; line-height: 1.55 }
.output-note .text-link { display: inline-flex; align-items: center; gap: 6px; color: var(--gold-light); font-size: 10px }
.diagnostics-layout { display: grid; grid-template-columns: minmax(0,1fr); gap: 13px; padding: 13px; border-color: rgba(216,181,106,.2); background: var(--panel) }
.diagnostics-layout .camera-preview { min-height: 320px }
.diagnostics-actions { display: flex; justify-content: flex-end }
.diagnostics-actions .primary,.diagnostics-actions .camera-secondary { min-width: 155px }
.studio-heading .eyebrow { display: none }
.studio-heading .lead { margin-bottom: 10px }
.capture-settings .setting-row:first-of-type { margin-top: 0 }
.camera-error,.camera-hint { padding: 8px 10px; border-radius: 6px; font-size: 10px }
.camera-hint { border: 1px solid rgba(216,181,106,.15); background: rgba(30,26,17,.52); color: #bdac83 }
.camera-error { border: 1px solid rgba(202,129,120,.25); background: rgba(49,23,21,.27); color: #df9b91 }
.page-content h1,.gate-card h1 { font-family: var(--serif) }
.card-icon.pink,.card-icon.violet,.card-icon.blue { border-color: rgba(216,181,106,.2); background: rgba(216,181,106,.06); color: var(--gold-light) }
.summary-card,.welcome-panel,.settings,.storage-settings,.diagnostics-link,.account-state,.plan-state,.activate-card,.empty-state,.photo-card { border-color: rgba(216,181,106,.16); border-radius: 10px; box-shadow: none }
.camera-secondary,.settings select,.camera-select-label select,.activate-card input { border-radius: 7px }
.photo-grid { gap: 13px }
.photo-card { background: #111 }
.empty-state { border-style: solid; background: #111 }
.notice { border-radius: 8px; font-size: 11px }
.sidebar button:focus-visible,.preview-tools button:focus-visible,.capture-disc:focus-visible,.strip-photo-actions button:focus-visible { outline-offset: 3px }
@media (max-width: 1180px) {
  .shell { grid-template-columns: 205px minmax(0,1fr) }
  .camera-panel.studio-layout { grid-template-columns: minmax(0,1.35fr) minmax(286px,.95fr); gap: 11px }
  .studio-right { gap: 9px }
  .control-section { padding: 13px }
  .capture-strip { grid-template-columns: minmax(0,1fr) 82px; gap: 8px; padding: 9px }
  .capture-disc { width: 65px; height: 65px }
  .capture-disc>span { width: 50px; height: 50px }
}
@media (max-width: 980px) {
  .shell { grid-template-columns: 72px minmax(0,1fr) }
  .sidebar { align-items: center; padding: 19px 7px 13px }
  .brand-button { justify-items: center; padding: 5px 0 8px }
  .brand-wordmark { font-size: 23px }
  .brand-subtitle,.side-label,.sidebar nav button>span:not(.nav-icon),.sidebar-license>span:last-child,.sidebar-account>span:not(.nav-icon),.sidebar-account>svg:last-child,.edition-meta span { display: none }
  .sidebar nav { width: 100%; margin-top: 21px }
  .sidebar nav button,.sidebar-account { justify-content: center; min-height: 42px; padding: 0 }
  .sidebar nav button.active::before,.sidebar-account.active::before { left: -1px }
  .nav-icon { flex: 0 0 auto }
  .sidebar-bottom { width: 100%; justify-items: center }
  .sidebar-license { justify-content: center; width: 100%; padding: 8px 0 }
  .edition-meta { justify-content: center; width: 100%; padding: 10px 0 0 }
  .camera-panel.studio-layout { grid-template-columns: minmax(0,1fr) }
  .studio-right { grid-template-columns: repeat(2,minmax(0,1fr)); align-items: start }
  .studio-right .output-note { align-self: stretch }
  .studio-heading h1 { font-size: 38px }
}
@media (max-width: 620px) {
  .shell { grid-template-columns: 58px minmax(0,1fr) }
  .sidebar { padding-inline: 4px }
  .brand-wordmark { font-size: 20px }
  .sidebar nav button,.sidebar-account { min-height: 38px }
  .topbar { height: 55px; padding: 0 11px }
  .topbar-actions { gap: 6px }
  .camera-top-status { display: none }
  .topbar-settings { width: 31px; height: 31px }
  .topbar-account { gap: 4px; padding: 4px; font-size: 0 }
  .license-chip { max-width: 105px; overflow: hidden; padding: 5px 7px; font-size: 7px; white-space: nowrap }
  .page-content,.studio-page { padding: 19px 12px 27px }
  .studio-heading { align-items: center; margin-bottom: 13px }
  .studio-heading h1 { font-size: clamp(30px,8vw,39px) }
  .studio-tagline { font-size: 8px; letter-spacing: .16em }
  .studio-live-state { padding: 6px 7px; font-size: 8px }
  .camera-selector-row { gap: 6px; flex-wrap: wrap }
  .camera-status-pill { flex: 1 0 100%; padding-left: 2px }
  .camera-select-label { flex: 1; margin-left: 0 }
  .camera-select-label select { width: 100%; min-width: 0; font-size: 10px }
  .camera-preview { min-height: 205px; aspect-ratio: 16/10 }
  .preview-tools { top: auto; bottom: 10px; left: 10px; display: flex; transform: none }
  .preview-tools button { width: 31px; height: 31px }
  .camera-placeholder { width: 94%; padding: 15px }
  .camera-placeholder .placeholder-icon { width: 45px; height: 45px }
  .camera-placeholder strong { font-size: 18px }
  .camera-placeholder small { font-size: 10px }
  .capture-strip { grid-template-columns: minmax(0,1fr) 66px; gap: 6px; padding: 7px }
  .strip-heading { align-items: flex-start; flex-direction: column; gap: 3px }
  .strip-heading small { max-width: 100%; font-size: 8px }
  .strip-photos { gap: 4px }
  .strip-photo { aspect-ratio: 1/1 }
  .strip-photo-actions { top: 2px; right: 2px; gap: 2px; opacity: 1 }
  .strip-photo-actions button { width: 21px; height: 21px }
  .capture-disc { width: 56px; height: 56px }
  .capture-disc>span { width: 43px; height: 43px }
  .capture-disc svg { width: 22px; height: 22px }
  .capture-caption { font-size: 7px; letter-spacing: .1em }
  .export-latest { font-size: 8px }
  .event-session-panel { flex-wrap: wrap; gap: 8px; padding: 10px }
  .event-icon { flex-basis: 37px; width: 37px; height: 37px }
  .event-copy { flex: 1 1 calc(100% - 100px) }
  .event-copy strong { font-size: 11px }
  .event-copy small { max-width: 100%; font-size: 8px }
  .storage-ready { flex-basis: 100%; margin-left: 46px }
  .studio-right { grid-template-columns: minmax(0,1fr) }
  .control-section { padding: 12px }
  .quick-action-grid>button,.coming-action { min-height: 48px }
  .diagnostics-layout .camera-preview { min-height: 205px }
  .photo-grid { grid-template-columns: repeat(2,minmax(0,1fr)) }
  .modal-caption { align-items: flex-start; flex-direction: column; font-size: 10px }
  .modal-actions { flex-wrap: wrap }
}
