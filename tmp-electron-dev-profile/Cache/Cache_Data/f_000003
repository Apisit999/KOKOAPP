.preview-loading { position: absolute; z-index: 3; display: flex; align-items: center; gap: 10px; padding: 12px 16px; border: 1px solid rgba(216,181,106,.17); border-radius: 8px; background: rgba(9,9,9,.84); color: #d4c9aa; font-size: 12px }
.countdown-overlay { z-index: 4; width: 104px; height: 104px; background: rgba(9,9,9,.82); color: var(--gold-light); font-family: var(--serif); font-size: 60px }
.capture-strip { display: grid; grid-template-columns: minmax(0,1fr) 93px; align-items: center; gap: 12px; min-width: 0; padding: 11px 12px; border: 1px solid rgba(216,181,106,.2); border-radius: 10px; background: linear-gradient(115deg,#111 0%,#101010 75%,#12110e 100%) }
.strip-main { min-width: 0 }
.strip-heading { display: flex; align-items: baseline; justify-content: space-between; gap: 10px; margin: 0 0 8px }
.panel-kicker { color: #aa9970; font-size: 9px; font-weight: 600; letter-spacing: .2em }
.strip-heading small { overflow: hidden; color: #89857c; font-size: 9px; text-overflow: ellipsis; white-space: nowrap }
.strip-photos { display: grid; grid-template-columns: repeat(4,minmax(0,1fr)); gap: 7px }
.strip-photo { position: relative; min-width: 0; overflow: hidden; aspect-ratio: 1.25/1; border: 1px solid rgba(216,181,106,.17); border-radius: 7px; background: #191919 }
