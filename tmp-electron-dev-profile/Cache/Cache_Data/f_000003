.strip-photo:hover .strip-thumb img { transform: scale(1.045) }
.strip-photo-actions { position: absolute; top: 5px; right: 5px; display: flex; gap: 4px; opacity: 0; transition: opacity .14s }
.strip-photo:hover .strip-photo-actions,.strip-photo:focus-within .strip-photo-actions { opacity: 1 }
.strip-photo-actions button { display: grid; place-items: center; width: 25px; height: 25px; border: 1px solid rgba(216,181,106,.28); border-radius: 5px; background: rgba(8,8,8,.86); color: #eee4ce }
