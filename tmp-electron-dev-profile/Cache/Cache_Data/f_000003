.preview-corners i:nth-child(1) { top: 0; left: 0; border-top-width: 1px; border-left-width: 1px }
.preview-corners i:nth-child(2) { top: 0; right: 0; border-top-width: 1px; border-right-width: 1px }
.preview-corners i:nth-child(3) { right: 0; bottom: 0; border-right-width: 1px; border-bottom-width: 1px }
.preview-corners i:nth-child(4) { bottom: 0; left: 0; border-bottom-width: 1px; border-left-width: 1px }
.preview-tools { position: absolute; z-index: 4; top: 50%; left: 14px; display: grid; gap: 3px; padding: 5px; border: 1px solid rgba(216,181,106,.16); border-radius: 8px; background: rgba(12,12,12,.81); transform: translateY(-50%) }
.preview-tools button { display: grid; place-items: center; width: 34px; height: 34px; border: 0; border-radius: 5px; background: transparent; color: #d0c8b7 }
.preview-tools button:hover,.preview-tools button.selected { background: rgba(216,181,106,.13); color: var(--gold-light) }
.composition-grid { position: absolute; z-index: 2; inset: 13px; pointer-events: none }
