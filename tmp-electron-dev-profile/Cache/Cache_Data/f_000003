.segmented-control button:hover:not(:disabled) { color: var(--gold-light) }
.segmented-control button.selected { border-color: rgba(244,217,154,.74); background: linear-gradient(160deg,rgba(216,181,106,.2),rgba(216,181,106,.09)); color: var(--gold-light); box-shadow: 0 0 0 1px rgba(216,181,106,.08) }
.segmented-control button small { margin-left: 4px; color: #a9a397; font-size: 8px }
.countdown-options { grid-template-columns: repeat(4,minmax(0,1fr)) }
.countdown-options button { min-height: 34px; font-size: 11px }
.cancel-session { display: inline-flex; align-items: center; justify-content: center; gap: 7px; min-height: 35px; margin-top: 13px; border: 1px solid rgba(202,129,120,.3); border-radius: 6px; background: rgba(49,23,21,.25); color: #d99a91; font-size: 10px }
.cancel-session:hover { border-color: rgba(202,129,120,.55); color: #f0aaa2 }
.quick-actions .section-heading { margin-bottom: 11px }
