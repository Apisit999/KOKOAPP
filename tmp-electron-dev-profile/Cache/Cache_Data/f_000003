:root {
  color-scheme: dark;
  font-family: 'Segoe UI', 'Leelawadee UI', Tahoma, sans-serif;
  font-synthesis: none;
  text-rendering: optimizeLegibility;
  --bg: #080808;
  --sidebar: #0b0b0b;
  --panel: #141414;
  --raised: #1c1c1c;
  --gold: #d8b56a;
  --gold-light: #f4d99a;
  --gold-muted: #92764a;
  --text: #f5f2ea;
  --secondary: #a5a29b;
  --border: rgba(216,181,106,.25);
  --green: #8ba88e;
  --red: #ca8178;
}
* { box-sizing: border-box }
html, body, #root { min-width: 360px; min-height: 100%; margin: 0; background: var(--bg) }
body, button, input, select { font: inherit }
button, select { color: inherit }
button { cursor: pointer }
button:disabled { cursor: not-allowed; opacity: .55 }
button:focus-visible, select:focus-visible, input:focus-visible { outline: 2px solid var(--gold); outline-offset: 3px }
.app { min-height: 100vh; background: var(--bg); color: var(--text) }
.shell { display: grid; grid-template-columns: 220px minmax(0,1fr); min-height: 100vh }
.sidebar { position: sticky; top: 0; height: 100vh; display: flex; flex-direction: column; padding: 24px 13px 16px; background: var(--sidebar); border-right: 1px solid rgba(255,255,255,.07) }
.brand { display: flex; align-items: center; gap: 11px; color: var(--text); font-size: 17px; font-weight: 700; letter-spacing: .04em }
.brand-button { padding: 5px 8px; border: 0; background: none; text-align: left }
.brand small { display: block; margin-top: 4px; color: var(--secondary); font-size: 8px; letter-spacing: .24em }
.brand-mark { display: grid; place-items: center; width: 37px; height: 37px; border: 1px solid var(--gold-muted); border-radius: 10px; color: var(--gold-light); font-family: 'Playfair Display', Georgia, serif; font-size: 22px }
.side-label { margin: 36px 11px 10px; color: #696963; font-size: 9px; font-weight: 700; letter-spacing: .18em }
.sidebar nav { display: grid; gap: 4px; padding: 0 }
.sidebar nav button, .sidebar-bottom>button { position: relative; display: flex; align-items: center; gap: 12px; width: 100%; min-height: 42px; padding: 0 11px; border: 1px solid transparent; border-radius: 8px; background: transparent; color: #aaa9a2; text-align: left; font-size: 12px }
.sidebar nav button:hover, .sidebar-bottom>button:hover { color: var(--text); background: rgba(255,255,255,.035) }
.sidebar nav button.active, .sidebar-bottom>button.active { border-color: rgba(214,179,106,.12); background: #191a1c; color: var(--text) }
.sidebar nav button.active::before, .sidebar-bottom>button.active::before { position: absolute; top: 8px; bottom: 8px; left: -1px; width: 2px; border-radius: 2px; background: var(--gold); content: '' }
.nav-icon { display: inline-grid; place-items: center; width: 17px; color: #7d7c76; font-size: 15px }
.sidebar nav .active .nav-icon, .sidebar-bottom .active .nav-icon { color: var(--gold) }
.nav-lock { display: none }
.sidebar-bottom { display: grid; gap: 3px; margin-top: auto }
.account-mini { display: flex; align-items: center; gap: 10px; margin-top: 12px; padding: 15px 7px 2px; border-top: 1px solid rgba(255,255,255,.07); font-size: 11px }
.account-mini small { display: block; margin-top: 4px; color: #77766f; font-size: 9px; font-weight: 400 }
.edition-meta { display: flex; align-items: center; justify-content: space-between; gap: 8px; padding: 13px 8px 0; color: #66655f; font-size: 8px; letter-spacing: .11em }.edition-meta small { color: #8b8980; font-size: 8px; letter-spacing: 0 }
.avatar { display: grid; place-items: center; width: 29px; height: 29px; border: 1px solid var(--border); border-radius: 50%; color: var(--gold-light); font-family: Georgia,serif }
.workspace { display: flex; flex-direction: column; min-width: 0 }
.topbar { position: sticky; z-index: 3; top: 0; display: flex; align-items: center; justify-content: space-between; gap: 16px; height: 61px; padding: 0 clamp(20px,3.2vw,44px); border-bottom: 1px solid rgba(255,255,255,.065); background: rgba(9,10,12,.96); color: #c4c1b8; font-size: 11px }
.crumb { color: #77766f }.crumb-sep { padding: 0 10px; color: #55544f }
.topbar-actions { display: flex; align-items: center; gap: 16px }
.camera-top-status { display: flex; align-items: center; gap: 6px; color: var(--secondary); font-size: 9px }.camera-top-status i { width: 6px; height: 6px; border-radius: 50%; background: #77766f }.camera-top-status.good { color: var(--green) }.camera-top-status.good i { background: var(--green) }.topbar-account { padding: 5px 7px; border: 0; background: transparent; color: #aaa89f; font-size: 10px }.topbar-account:hover { color: var(--gold-light) }
.license-chip { display: flex; align-items: center; gap: 7px; padding: 7px 10px; border: 1px solid var(--border); border-radius: 20px; color: #c8bc9e; font-size: 10px }
.license-chip>span { width: 6px; height: 6px; border-radius: 50%; background: var(--gold) }
.version { color: #6c6b65; font-size: 10px }
.page-content { width: min(1440px,100%); flex: 1; margin: 0 auto; padding: 36px clamp(20px,3.2vw,44px) 48px }
.page-content h1 { margin: 9px 0 7px; font-size: clamp(26px,2.6vw,36px); font-weight: 500; letter-spacing: -.035em; line-height: 1.25 }
.eyebrow { margin: 0; color: var(--gold); font-size: 9px; font-weight: 700; letter-spacing: .19em }
.lead { max-width: 660px; margin: 8px 0 25px; color: var(--secondary); font-size: 12px; line-height: 1.8 }
.welcome-row { display: flex; align-items: center; justify-content: space-between; gap: 24px; margin-bottom: 26px }
.welcome-row h1 { max-width: 750px; margin-top: 11px; font-size: clamp(29px,3vw,41px) }
.welcome-row .lead { margin: 7px 0 0 }
.primary, .capture-button { display: inline-flex; align-items: center; justify-content: center; gap: 10px; min-height: 44px; padding: 0 17px; border: 1px solid #e4c77d; border-radius: 8px; background: var(--gold); color: #17140d; font-size: 12px; font-weight: 700; transition: background .15s,border-color .15s,transform .15s }
.primary:hover, .capture-button:hover { transform: translateY(-1px); border-color: var(--gold-light); background: var(--gold-light) }
.start-button { min-height: 48px; flex: 0 0 auto }
.start-button>span:first-child { font-size: 17px }.start-button>span:last-child { margin-left: 8px }
.dashboard-cards { display: grid; grid-template-columns: repeat(3,minmax(0,1fr)); gap: 12px }
.summary-card { min-height: 164px; padding: 17px; border: 1px solid rgba(255,255,255,.08); border-radius: 10px; background: var(--panel) }
.card-heading, .card-heading>div { display: flex; align-items: center }.card-heading { justify-content: space-between; gap: 8px }.card-heading>div { gap: 10px; min-width: 0 }
.card-heading small { display: block; color: #797870; font-size: 8px; letter-spacing: .14em }.card-heading h2 { margin: 4px 0 0; font-size: 13px; font-weight: 600 }
.card-icon { display: grid; flex: 0 0 auto; place-items: center; width: 33px; height: 33px; border: 1px solid var(--border); border-radius: 8px; color: var(--gold); font-size: 15px }
.card-icon.pink,.card-icon.violet,.card-icon.blue { border-color: var(--border); background: #1b1a17; color: var(--gold) }
.status-dot { display: inline-flex; align-items: center; gap: 6px; color: #b3a37d; font-size: 9px; white-space: nowrap }.status-dot:before { width: 6px; height: 6px; border-radius: 50%; background: currentColor; content: '' }.status-dot.good { color: var(--green) }.status-dot.neutral { color: var(--secondary) }
.summary-card>p { min-height: 39px; margin: 17px 0 11px; color: var(--secondary); font-size: 11px; line-height: 1.7 }
.text-link { padding: 0; border: 0; background: none; color: var(--gold); font-size: 10px; font-weight: 600 }.text-link:hover { color: var(--gold-light) }.text-link span { margin-left: 4px }
.welcome-panel { display: flex; align-items: center; justify-content: space-between; min-height: 146px; overflow: hidden; margin-top: 17px; padding: 25px 29px; border: 1px solid var(--border); border-radius: 10px; background: linear-gradient(105deg,#191814,#121315 68%,#17150f) }
.panel-kicker { color: var(--gold-muted); font-size: 8px; font-weight: 700; letter-spacing: .17em }.welcome-panel h2 { margin: 9px 0 6px; font-family: 'Playfair Display',Georgia,serif; font-size: 20px; font-weight: 500 }.welcome-panel p { max-width: 590px; margin: 0; color: var(--secondary); font-size: 11px; line-height: 1.7 }
.panel-art { display: grid; place-items: center; width: 110px; height: 90px; color: var(--gold-muted); opacity: .6 }.panel-art span:first-child { font-size: 70px }.panel-art span:nth-child(2),.panel-art span:nth-child(3) { display: none }
.recent-section { margin-top: 26px }.section-heading { display: flex; align-items: center; justify-content: space-between; margin-bottom: 11px }.section-heading h2 { margin: 0; font-size: 14px }.section-heading p { margin: 5px 0 0; color: var(--secondary); font-size: 10px }
.steps { display: grid; grid-template-columns: repeat(3,minmax(0,1fr)); overflow: hidden; border: 1px solid rgba(255,255,255,.08); border-radius: 9px; background: var(--panel) }.steps>div { display: flex; align-items: center; gap: 10px; min-width: 0; padding: 13px; border-right: 1px solid rgba(255,255,255,.07) }.steps>div:last-child { border: 0 }.step-number { color: var(--gold); font-size: 9px; font-weight: 700 }.steps strong,.steps small { display: block }.steps strong { font-size: 10px }.steps small { margin-top: 4px; color: var(--secondary); font-size: 9px; line-height: 1.5 }.steps button { flex: 0 0 auto; margin-left: auto; border: 0; background: none; color: var(--gold); font-size: 14px }
.workspace footer { display: flex; justify-content: space-between; gap: 16px; margin-top: auto; padding: 13px clamp(20px,3.2vw,44px); border-top: 1px solid rgba(255,255,255,.065); color: #77766f; font-size: 9px }.workspace footer span:first-child { display: flex; align-items: center; gap: 7px; color: #a4a298 }.footer-indicator { width: 6px; height: 6px; border-radius: 50%; background: var(--green) }
.studio-heading { display: flex; align-items: center; justify-content: space-between; gap: 20px }.studio-heading .lead { margin-bottom: 18px }.studio-layout { display: grid; grid-template-columns: minmax(0,1fr) 245px; align-items: start; gap: 14px }
.camera-panel { display: grid; grid-template-columns: minmax(0,1fr) 235px; gap: 15px; min-width: 0; padding: 13px; border: 1px solid var(--border); border-radius: 11px; background: var(--panel) }
.camera-preview { position: relative; display: grid; place-items: center; min-width: 0; min-height: 300px; aspect-ratio: 16/10; overflow: hidden; border: 1px solid rgba(255,255,255,.07); border-radius: 7px; background: #08090a }
.camera-preview video { display: block; width: 100%; height: 100%; object-fit: contain }.camera-placeholder { display: flex; flex-direction: column; align-items: center; gap: 9px; padding: 22px; color: #b7b4ab; text-align: center; font-size: 12px }.camera-placeholder .camera-icon { color: var(--gold-muted); font-size: 43px }.camera-placeholder small { max-width: 250px; color: #77766f; font-size: 10px; line-height: 1.6 }
.live-badge { position: absolute; top: 12px; left: 12px; display: flex; align-items: center; gap: 6px; padding: 5px 7px; border: 1px solid rgba(214,179,106,.35); border-radius: 4px; background: #090a0ccc; color: var(--gold-light); font-size: 8px; letter-spacing: .1em }.live-badge i { width: 5px; height: 5px; border-radius: 50%; background: var(--gold) }.countdown-overlay { position: absolute; display: grid; place-items: center; width: 100px; height: 100px; border: 1px solid var(--gold); border-radius: 50%; background: #090a0caa; color: var(--gold-light); font-size: 56px; font-weight: 500 }
.camera-controls { display: flex; flex-direction: column; gap: 13px; min-width: 0; padding: 5px 3px }.camera-heading { display: flex; align-items: center; justify-content: space-between; gap: 8px }.camera-heading h2 { margin: 0; font-size: 14px; font-weight: 600 }.camera-state { color: var(--secondary); font-size: 9px }.camera-state.ready { color: var(--green) }.camera-state.permission-denied,.camera-state.error,.camera-state.disconnected { color: var(--red) }
.camera-select-label,.compact-field { display: flex; flex-direction: column; gap: 6px; color: #c7c4ba; font-size: 10px }.camera-select-label select,.compact-field select,.settings select { width: 100%; min-height: 39px; padding: 8px 10px; border: 1px solid rgba(255,255,255,.12); border-radius: 6px; background: var(--raised); color: var(--text); font-size: 10px }.camera-actions { display: flex; flex-wrap: wrap; gap: 7px; margin-top: auto }.camera-actions .primary,.camera-actions .capture-button { flex: 1 1 100%; min-height: 48px }.camera-actions .camera-secondary { flex: 1 1 auto }
.camera-secondary { min-height: 37px; padding: 8px 11px; border: 1px solid rgba(255,255,255,.12); border-radius: 6px; background: var(--raised); color: #d5d1c6; font-size: 10px }.camera-secondary:hover { border-color: var(--border); color: var(--gold-light) }.camera-error { margin: 0; color: var(--red); font-size: 10px; line-height: 1.5 }.camera-hint { margin: 0; color: #aa9c7c; font-size: 9px; line-height: 1.6 }
.cancel-session { border-color: rgba(202,129,120,.28); color: #d39790 }.cancel-session:hover { border-color: rgba(202,129,120,.55); color: #f0aaa2 }
.studio-rail { display: grid; gap: 12px }.session-panel { padding: 16px; border: 1px solid rgba(255,255,255,.08); border-radius: 9px; background: var(--panel) }.session-panel h2 { margin: 8px 0 6px; font-size: 12px; font-weight: 600 }.session-panel p { margin: 0 0 13px; color: var(--secondary); font-size: 10px; line-height: 1.65 }.recent-frames { display: grid; grid-template-columns: repeat(3,1fr); gap: 5px; margin: 11px 0 12px }.recent-frames button { display: grid; place-items: center; aspect-ratio: 1.2; border: 1px solid rgba(255,255,255,.08); border-radius: 5px; background: #1d1d1a; color: var(--gold-muted) }
.status-grid { display: grid; grid-template-columns: repeat(3,minmax(0,1fr)); gap: 12px }.status-grid article { min-width: 0 }
.settings,.storage-settings,.diagnostics-link,.account-state,.plan-state { max-width: 850px; border: 1px solid rgba(255,255,255,.08); border-radius: 9px; background: var(--panel) }.settings { padding: 4px 19px }.settings label { display: flex; align-items: center; justify-content: space-between; gap: 18px; padding: 16px 0; border-bottom: 1px solid rgba(255,255,255,.07); font-size: 11px }.settings label:last-child { border: 0 }.settings small { display: block; margin-top: 5px; color: var(--secondary); font-size: 9px }.settings select { width: auto; min-width: 115px }.settings input { width: 18px; height: 18px; accent-color: var(--gold) }
.storage-settings { display: grid; grid-template-columns: 1fr auto; align-items: center; gap: 10px; margin-top: 13px; padding: 17px 19px }.storage-settings strong,.diagnostics-link strong { font-size: 11px }.storage-settings p { margin: 6px 0; color: var(--secondary); font-size: 10px }.storage-settings small { color: #a7a398; font-size: 9px }.storage-settings>p { grid-column: 1/-1; margin: 0 }.storage-warning { display: block; margin-top: 5px; color: var(--gold) }
.diagnostics-link { display: flex; align-items: center; justify-content: space-between; gap: 15px; max-width: 850px; margin-top: 12px; padding: 15px 19px }.diagnostics-link p { margin: 5px 0 0; color: var(--secondary); font-size: 9px }
